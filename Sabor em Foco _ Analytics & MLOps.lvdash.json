{
  "datasets": [
    {
      "name": "mensal",
      "displayName": "Volume mensal",
      "queryLines": [
        "SELECT CAST(DATE_TRUNC('MONTH',data_avaliacao) AS DATE) AS mes, COUNT(*) AS volume, ROUND(100*AVG(CAST(alvo_baixa_nota AS DOUBLE)),2) AS taxa_baixa_nota_pct FROM workspace.sabor_dev.silver_reviews GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "produtos",
      "displayName": "Produtos críticos",
      "queryLines": [
        "SELECT ProductId AS produto, COUNT(*) AS volume, ROUND(100*AVG(CAST(alvo_baixa_nota AS DOUBLE)),2) AS taxa_baixa_nota_pct FROM workspace.sabor_dev.silver_reviews GROUP BY ProductId HAVING COUNT(*) >= 20 ORDER BY AVG(CAST(alvo_baixa_nota AS DOUBLE)) DESC, COUNT(*) DESC, ProductId LIMIT 20"
      ]
    },
    {
      "name": "negocio",
      "displayName": "Totais Silver",
      "queryLines": [
        "SELECT COUNT(*) AS avaliacoes, COUNT(DISTINCT ProductId) AS produtos FROM workspace.sabor_dev.silver_reviews"
      ]
    },
    {
      "name": "qualidade",
      "displayName": "Qualidade e quarentena",
      "queryLines": [
        "SELECT 'Bronze histórico' AS indicador, COUNT(*) AS registros FROM workspace.sabor_dev.bronze_reviews UNION ALL SELECT 'Silver atual',COUNT(*) FROM workspace.sabor_dev.silver_reviews UNION ALL SELECT 'Quarentena histórica',COUNT(*) FROM workspace.sabor_dev.quarentena_reviews UNION ALL SELECT 'Quarentena sintética (teste)',COUNT(*) FROM workspace.sabor_dev.quarentena_reviews_teste UNION ALL SELECT 'Gold ML deduplicada',COUNT(*) FROM workspace.sabor_dev.gold_reviews_ml_deduplicada"
      ]
    },
    {
      "name": "ml",
      "displayName": "Métricas dos lotes rotulados",
      "queryLines": [
        "SELECT lote_id, versao_modelo, n_operacional AS amostra, ROUND(100*precision_classe_1,2) AS precision_pct, ROUND(100*recall_classe_1,2) AS recall_pct, ROUND(100*f1_classe_1,2) AS f1_pct FROM workspace.sabor_operacao.monitoramento_reviews UNION ALL SELECT lote_id, versao_modelo, 1000 AS amostra, ROUND(100*precision,2),ROUND(100*recall,2),ROUND(100*f1,2) FROM workspace.sabor_operacao.metricas_lote2"
      ]
    },
    {
      "name": "drift",
      "displayName": "Monitoramento",
      "queryLines": [
        "SELECT lote_id, versao_modelo, n_treino,n_operacional, ROUND(media_caracteres_treino,2) AS media_treino,ROUND(media_caracteres_lote,2) AS media_lote,ROUND(drift_texto_pct,2) AS drift_pct,alerta_drift,ROUND(predicao_classe_1_treino_pct,2) AS classe1_treino_pct,ROUND(predicao_classe_1_lote_pct,2) AS classe1_lote_pct FROM workspace.sabor_operacao.monitoramento_reviews"
      ]
    },
    {
      "name": "sentimento",
      "displayName": "Sentimentos",
      "queryLines": [
        "SELECT resultado AS sentimento,COUNT(*) AS quantidade FROM workspace.sabor_operacao.resultados_ia WHERE funcao='ai_analyze_sentiment' AND status='SUCESSO' GROUP BY resultado"
      ]
    },
    {
      "name": "operacao",
      "displayName": "Execuções reais do Job",
      "queryLines": [
        "SELECT job_run_id, etapa, status, COUNT(*) AS tentativas, ROUND(SUM(duracao_segundos),2) AS segundos, SUM(registros_entrada) AS registros_entrada,SUM(registros_saida) AS registros_saida,SUM(registros_invalidos) AS invalidos,COUNT_IF(status='FALHA') AS falhas FROM workspace.sabor_operacao.logs_execucao WHERE job_run_id NOT LIKE 'teste_manual%' GROUP BY job_run_id,etapa,status ORDER BY job_run_id,etapa"
      ]
    },
    {
      "name": "uso_ia",
      "displayName": "Uso das AI Functions",
      "queryLines": [
        "SELECT funcao,COUNT(*) AS textos_submetidos,COUNT(DISTINCT Id) AS ids_distintos,COUNT_IF(status='SUCESSO') AS sucessos,COUNT_IF(status='FALHA') AS falhas,COUNT_IF(status='NULO') AS nulos,COUNT_IF(texto_truncado) AS truncados,ROUND(SUM(duracao_segundos),2) AS segundos FROM workspace.sabor_operacao.resultados_ia GROUP BY funcao"
      ]
    }
  ],
